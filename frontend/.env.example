# Copy to .env.local and fill in

# Register a public client at https://orcid.org/developer-tools
# (use sandbox.orcid.org for development)
VITE_ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
VITE_ORCID_BASE_URL=https://sandbox.orcid.org

# Cloudflare Worker base URL
VITE_WORKER_URL=http://localhost:8787

# Target repo for SPARQL example submissions
VITE_GITHUB_REPO=koetai/sparql-examples
